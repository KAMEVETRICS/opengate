{
  "name": "builder_boost",
  "description": "OpenGate policy v2: builders count double; no staker's tier ever goes down",
  "inputs": [
    { "name": "size", "bits": 2 },
    { "name": "age", "bits": 2 },
    { "name": "builder", "bits": 1 },
    { "name": "ignix", "bits": 1 }
  ],
  "outputs": [
    { "name": "level", "bits": 3, "expr": "min(7, size + age + 2 * builder + ignix)" }
  ]
}
