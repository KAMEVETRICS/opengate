{
  "name": "seven_seg",
  "description": "Hex digit to seven-segment display (segments a..g, 1 = lit)",
  "inputs": [
    {
      "name": "d",
      "bits": 4
    }
  ],
  "outputs": [
    {
      "name": "seg",
      "bits": 7,
      "expr": "d==0?0x3f:d==1?0x06:d==2?0x5b:d==3?0x4f:d==4?0x66:d==5?0x6d:d==6?0x7d:d==7?0x07:d==8?0x7f:d==9?0x6f:d==10?0x77:d==11?0x7c:d==12?0x39:d==13?0x5e:d==14?0x79:0x71"
    }
  ]
}
