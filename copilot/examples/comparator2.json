{
  "name": "comparator2",
  "description": "2-bit magnitude comparator",
  "inputs": [
    {
      "name": "a",
      "bits": 2
    },
    {
      "name": "b",
      "bits": 2
    }
  ],
  "outputs": [
    {
      "name": "gt",
      "bits": 1,
      "expr": "a > b"
    },
    {
      "name": "eq",
      "bits": 1,
      "expr": "a == b"
    },
    {
      "name": "lt",
      "bits": 1,
      "expr": "a < b"
    }
  ]
}
