{
  "name": "builders_first",
  "description": "OpenGate policy: builders get the long-term age bonus right away",
  "inputs": [
    {
      "name": "size",
      "bits": 2
    },
    {
      "name": "age",
      "bits": 2
    },
    {
      "name": "builder",
      "bits": 1
    },
    {
      "name": "ignix",
      "bits": 1
    }
  ],
  "outputs": [
    {
      "name": "level",
      "bits": 3,
      "expr": "min(7, size + (builder ? 3 : age) + ignix)"
    }
  ]
}
